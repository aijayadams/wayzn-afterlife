; Copy to secrets.ini (gitignored) and fill in. Used by env esp32dev-net / esp32dev-net-ota
; and firmware/brain (api_token = the HTTP API bearer token for Home Assistant; syslog_host = an IP to send
; RFC 5424 syslog to on UDP 5514, empty = off).
[secrets]
wifi_ssid = your-ssid
wifi_psk = your-wifi-password
ota_pass = pick-an-ota-password
api_token = pick-a-long-random-token
syslog_host =
